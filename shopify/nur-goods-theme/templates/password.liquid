{%- comment -%}Password page. Native Shopify storefront password form only.{%- endcomment -%}
<div style="max-width:22rem;margin:2rem auto 0">
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="visually-hidden" for="password">Password</label>
    <input class="field" style="width:100%" id="password" type="password" name="password" autocomplete="current-password">
    <button type="submit" class="btn btn--primary btn--full" style="margin-top:.75rem">Enter</button>
  {%- endform -%}
</div>
