<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ shop.name }}</title>
    <link rel="stylesheet" href="{{ 'nur-theme.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    <main id="main" class="wrap" style="padding-block:5rem;text-align:center">
      {% render 'brand-logo', treatment: 'horizontal', surface: 'light', height: 72, class: 'logo-center' %}
      <h1 class="page-title">{{ shop.name }}</h1>
      <p class="page-lede" style="margin-inline:auto">{{ settings.brand_tagline }}</p>
      {{ content_for_layout }}
    </main>
  </body>
</html>
