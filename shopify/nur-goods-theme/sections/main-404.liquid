<div class="wrap" style="padding-block:4rem 6rem;text-align:center">
  <h1 class="page-title" style="margin-top:0">Page not found</h1>
  <p class="page-lede" style="margin-inline:auto">That page has moved or no longer exists. Search the range or head back to the homepage.</p>
  <div style="max-width:32rem;margin:2rem auto 0">
    {% render 'search-form', id: 'notfound-search' %}
  </div>
  <a class="btn btn--primary" style="margin-top:1.5rem" href="{{ routes.all_products_collection_url }}">Browse the range</a>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
