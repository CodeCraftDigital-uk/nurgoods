{%- comment -%}
  Product rail used for "Recently added" and any other curated row.
  Sits immediately below the hero on the homepage, as on the live site.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.count | default: 8
-%}
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}
          <p class="section-lede">{{ section.settings.lede }}</p>
        {%- endif -%}
      </div>
      <a class="link-underline" href="{{ source.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
    </div>

    {%- if source.products.size > 0 -%}
      <ul class="product-grid{% if section.settings.count > 4 %} product-grid--wide{% endif %}" style="margin-top:1.5rem">
        {%- for product in source.products limit: limit -%}
          <li>{% render 'product-card', product: product, loading: 'lazy' %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-state" style="margin-top:1.5rem">
        <p class="section-lede" style="margin-inline:auto">Products appear here as soon as the catalogue is published.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently added" },
    { "type": "textarea", "id": "lede", "label": "Supporting text", "default": "The newest additions to the NUR GOODS range." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all products" }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
