{%- comment -%}
  Marketplace header mirroring the headless PublicShell: logo, centred search,
  support and basket, category/primary nav row and the service strip.
  Collections is deliberately not a top level item.
{%- endcomment -%}
<header class="header">
  <div class="header__bar">
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      <span class="visually-hidden">{{ shop.name }}</span>
      {% render 'brand-logo', treatment: 'horizontal', surface: 'light', height: 64 %}
    </a>

    <div class="header__desktop-search">
      {% render 'search-form', id: 'header-search' %}
    </div>

    <div class="header__actions">
      {%- if section.settings.support_link != blank -%}
        <a class="header__support" href="{{ section.settings.support_link }}">
          {% render 'icon', name: 'support' %}
          Support
        </a>
      {%- endif -%}

      <a class="cart-toggle" href="{{ routes.cart_url }}" data-open-cart aria-label="Open basket">
        {% render 'icon', name: 'bag' %}
        <span class="cart-toggle__label">Basket</span>
        <span class="cart-toggle__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <button type="button" class="icon-btn icon-btn--menu" data-open-menu aria-label="Open menu">
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>

  <div class="header__mobile-search">
    {% render 'search-form', id: 'header-search-mobile', compact: true, placeholder: 'Search products' %}
  </div>

  <div class="header__nav-row">
    <nav class="nav" aria-label="Primary">
      {% render 'primary-nav', menu: section.settings.menu, link_class: 'nav__link' %}
    </nav>
  </div>
</header>

<div class="mobile-menu" data-mobile-menu hidden>
  <button type="button" class="drawer__scrim" data-close-overlay aria-label="Close menu"></button>
  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__head" style="padding-inline:0">
      {% render 'brand-logo', treatment: 'horizontal', surface: 'light', height: 34 %}
      <button type="button" class="icon-btn" data-close-overlay aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    </div>
    <div style="margin-top:1rem">
      {% render 'search-form', id: 'menu-search', compact: true, placeholder: 'Search products' %}
    </div>
    <nav aria-label="Primary mobile" style="margin-top:1rem">
      {% render 'primary-nav', menu: section.settings.menu, link_class: 'mobile-menu__link' %}
    </nav>
    {% render 'contact-link', label: 'Contact us', style: 'display:inline-block;margin-top:1.5rem;font-size:.875rem;color:var(--muted-foreground)' %}
  </div>
</div>

{%- if section.settings.show_service_strip -%}
  <div class="service-strip">
    <ul>
      {%- for block in section.blocks -%}
        {%- if block.type == 'service' -%}
          <li {{ block.shopify_attributes }}><span class="dot-gold" aria-hidden="true"></span>{{ block.settings.text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Primary menu", "default": "main-menu" },
    { "type": "url", "id": "support_link", "label": "Support link" },
    { "type": "checkbox", "id": "show_service_strip", "label": "Show service strip", "default": true }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service cue",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Free shipping in the UK & USA." }]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "service", "settings": { "text": "Free shipping in the UK & USA." } },
      { "type": "service", "settings": { "text": "Secure checkout on the NUR GOODS store" } },
      { "type": "service", "settings": { "text": "Support from a person, through the contact form" } }
    ]
  }
}
{% endschema %}
