{%- comment -%}Three service cues. Factual statements only.{%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="cue-grid">
      {%- for block in section.blocks -%}
        <div class="cue glass-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Service cues",
  "blocks": [
    {
      "type": "cue",
      "name": "Cue",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ordered on the main store" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Payment, delivery options and order tracking are handled by the NUR GOODS store checkout." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Service cues",
      "blocks": [
        { "type": "cue", "settings": { "heading": "Ordered on the main store", "body": "Payment, delivery options and order tracking are handled by the NUR GOODS store checkout." } },
        { "type": "cue", "settings": { "heading": "One range, kept in step", "body": "Everything listed here is read directly from the live store catalogue, so nothing is shown that is not stocked." } },
        { "type": "cue", "settings": { "heading": "A person answers", "body": "Write to support@nurgoods.com with any question before or after ordering." } }
      ]
    }
  ]
}
{% endschema %}
