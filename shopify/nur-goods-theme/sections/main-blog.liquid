{%- comment -%}Journal index.{%- endcomment -%}
<div class="wrap" style="padding-block:1.5rem 4rem">
  {% render 'breadcrumbs' %}
  <h1 class="page-title">{{ blog.title }}</h1>
  <p class="page-lede">{{ section.settings.lede }}</p>

  {%- paginate blog.articles by 12 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a class="article-card glass-card" href="{{ article.url }}">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 640 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="640" height="360" loading="lazy" style="border-radius:.75rem;aspect-ratio:16/9;object-fit:cover;margin-bottom:1rem">
          {%- endif -%}
          <h3>{{ article.title }}</h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          <p style="margin-top:auto;padding-top:1rem;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-foreground)">{{ article.published_at | date: '%-d %B %Y' }}</p>
        </a>
      {%- else -%}
        <div class="empty-state"><p class="section-lede" style="margin-inline:auto">No articles published yet.</p></div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "Supporting text", "default": "Practical guides and considered notes from the NUR GOODS team." }
  ]
}
{% endschema %}
