{%- comment -%}
  SEO/AEO metadata. Shopify already emits some tags through content_for_header,
  so this snippet only adds title, description and social cards.
{%- endcomment -%}

{%- liquid
  assign meta_title = page_title
  assign meta_description = page_description

  if template.name == 'index' and page_title == shop.name
    assign meta_title = shop.name | append: ' | ' | append: settings.brand_tagline
  endif

  if meta_description == blank
    assign meta_description = settings.default_meta_description
  endif

  assign social_image = settings.social_share_image
  if template.name == 'product' and product.featured_media
    assign social_image = product.featured_media.preview_image
  elsif template.name == 'article' and article.image
    assign social_image = article.image
  elsif template.name == 'collection' and collection.image
    assign social_image = collection.image
  endif
-%}

<title>{{ meta_title }}{% if current_page > 1 %} &ndash; Page {{ current_page }}{% endif %}</title>
{%- if meta_description != blank %}
  <meta name="description" content="{{ meta_description | strip_html | truncate: 300 | escape }}">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:description" content="{{ meta_description | strip_html | truncate: 300 | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
{%- if social_image %}
  <meta property="og:image" content="http:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:image" content="http:{{ social_image | image_url: width: 1200 }}">
{%- else %}
  <meta property="og:image" content="{{ 'og-nurgoods-v2.jpg' | asset_url | prepend: 'https:' | split: '?' | first }}">
  <meta name="twitter:image" content="{{ 'og-nurgoods-v2.jpg' | asset_url | prepend: 'https:' | split: '?' | first }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | strip_html | truncate: 300 | escape }}">
