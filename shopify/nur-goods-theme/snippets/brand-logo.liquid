{%- comment -%}
  Official NUR GOODS artwork only. Never recoloured, never redrawn.
  Params: treatment (horizontal | square), surface (light | dark), height, class.
{%- endcomment -%}
{%- liquid
  assign treatment = treatment | default: 'horizontal'
  assign surface = surface | default: 'light'
  assign height = height | default: 64

  if treatment == 'square'
    assign ratio = 1.0
    if surface == 'dark'
      assign file = 'nur-goods-square-dark.png'
    else
      assign file = 'nur-goods-square-light.png'
    endif
  else
    assign ratio = 2.5
    if surface == 'dark'
      assign file = 'nur-goods-horizontal-dark.png'
    else
      assign file = 'nur-goods-horizontal-light.png'
    endif
  endif

  assign width = height | times: ratio | round
  assign retina_height = height | times: 2

  if surface == 'dark'
    assign custom = settings.logo_dark
  else
    assign custom = settings.logo_light
  endif

  assign custom_width = width
  if custom != blank and custom.height > 0
    assign custom_width = custom.width | times: height | divided_by: custom.height | round
  endif
  if custom_width == 0
    assign custom_width = width
  endif
-%}
{%- if custom != blank -%}
  <img src="{{ custom | image_url: height: retina_height }}" alt="{{ shop.name | escape }}" width="{{ custom_width }}" height="{{ height }}" style="height:{{ height }}px;width:auto" class="{{ class }}">

{%- else -%}
  <img src="{{ file | asset_url }}" alt="{{ shop.name | escape }}" width="{{ width }}" height="{{ height }}" style="height:{{ height }}px;width:auto" class="{{ class }}">
{%- endif -%}
